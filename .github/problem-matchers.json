{
  "problemMatcher": [
    {
      "owner": "cmake",
      "pattern": [
        {
          "regexp": "^CMake Error at (.+):(\\d+) \\(.+\\):$",
          "file": 1,
          "line": 2
        },
        {
          "regexp": "^\\s+(.+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "gcc",
      "pattern": [
        {
          "regexp": "^(?:C/C\\+\\+: )?(.+?):(\\d+):(?:(\\d+):)? (?:fatal )?error: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "msvc",
      "pattern": [
        {
          "regexp": "^\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*: (?:fatal )?(?:error(?! C2220)|warning(?= C[45]\\d{3}))(?: (\\w+))?\\s*: (.*?)(?: \\[[^\\]]+\\.vcxproj\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
